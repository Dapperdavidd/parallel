# Copy to .env and fill in. The .env file is gitignored, and so is web/.env.local.
#
# Nothing here is required to run Parallel on one machine: with none of it set,
# the app reads the JSON files under data/, signs with the keypairs in wallets/,
# and talks to public devnet. Production is the opposite — it refuses to start
# without the variables marked "production" below, because a deployment that
# quietly falls back to local files looks healthy while serving stale prices.
# See web/src/lib/server/env.ts.

# ----------------------------------------------------------------- network --

# Solana devnet RPC endpoint. Anything that is not devnet is refused.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ------------------------------------------------------------------- auth --

# Privy app id, from https://dashboard.privy.io. Public, client-side value.
# (production)
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------- database --

# Supabase project. The service role key is server-only: it is the role the
# schema grants writes and hedge reads to, and the anon key silently refuses
# both. Never expose it to a browser. (production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The right key for a browser, and only for a browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- secrets --

# Signs the short-lived quote and ownership-challenge tokens. At least 32
# characters, and rotating it only invalidates tokens in flight. (production)
#   openssl rand -base64 48
PARALLEL_APP_SECRET=

# ------------------------------------------------------------ signing keys --
#
# Two ways to give the web app the signatures it needs, in order of preference.
#
# 1. A separate signer (preferred). The web app then holds no key at all: it
#    sends the transaction message to a service that does, and that service
#    will only sign Percolator trades against registry markets. Run it on the
#    machine that holds the keys:
#
#      PARALLEL_SIGNER_SECRET=… npm run signer -- --port=8787
#
PARALLEL_SIGNER_URL=
PARALLEL_SIGNER_SECRET=
# Where the signer itself listens. Loopback by default, on purpose.
PARALLEL_SIGNER_HOST=127.0.0.1
PARALLEL_SIGNER_PORT=8787

# 2. Keys in the web app's own environment. Simpler, and the whole process
#    becomes key-bearing. One of these is required in production, because
#    reading the repository's wallets/ folder is refused there. (production)
#
#    A JSON object of currency code to secret-key byte array:
#      {"NGN":[12,34,…],"ZAR":[…]}
PARALLEL_LIQUIDITY_SECRETS=
#    Or a directory outside the repository holding liquidity-<code>.json
PARALLEL_LIQUIDITY_SECRETS_DIR=

# The faucet's mint authority, which mints the devnet test token. One of these
# is required in production, for the same reason. (production)
PARALLEL_MINT_AUTHORITY_SECRET=
PARALLEL_MINT_AUTHORITY_FILE=

# ------------------------------------------------------------------ paths --

# Overrides for the committed registry and the local data directory. Useful
# when the web app and the services do not share a working directory.
PARALLEL_REGISTRY=
PARALLEL_DATA_DIR=

# Forces the production or development contract explicitly, rather than
# inferring it from NODE_ENV.
PARALLEL_ENV=
