{
  "name": "parallel-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../eslint.config.mjs .",
    "test": "PARALLEL_APP_SECRET=\"a-test-secret-at-least-thirty-two-characters\" tsx --tsconfig tsconfig.test.json --test \"test/**/*.test.ts\"",
    "test:watch": "PARALLEL_APP_SECRET=\"a-test-secret-at-least-thirty-two-characters\" tsx --tsconfig tsconfig.test.json --test --watch \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.52.0",
    "@solana-program/memo": "^0.16.0",
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.119.2",
    "buffer": "^6.0.3",
    "lightweight-charts": "^4.2.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "stream-json": "^3.9.0",
    "postcss": "^8.5.33",
    "zod": "^4.6.7"
  }
}
