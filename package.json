{
  "name": "parallel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel \u2014 perpetual futures on emerging-market currencies, on Solana devnet via Percolator. Phase 1: feasibility scripts only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "spike1": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike1-market.ts",
    "spike2": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike2-oracle-push.ts",
    "spike3": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike3-trade.ts",
    "spike4": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike4-liquidation.ts",
    "spike5": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike5-index.ts",
    "spike6": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike6-oracle-loop.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/inspect.ts",
    "spike7:fund": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike7-fund.ts",
    "spike7": "npm --prefix spike7 run dev",
    "spike7:verify": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/spikes/spike7-verify.ts",
    "index": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/index-service.ts",
    "balances": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/tools/balances.ts",
    "markets:create": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/create-markets.ts",
    "vaults:create": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/create-liquidity-vaults.ts",
    "keeper": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/keeper.ts",
    "backfill": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/backfill-official.ts",
    "store:check": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/tools/store-check.ts",
    "sources:probe": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/tools/probe-sources.ts",
    "dns:check": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/tools/dns-check.ts",
    "signer": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/signer.ts",
    "cloud": "node scripts/cloud-services.mjs",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:all": "npm test && npm --prefix web test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "reconcile": "node --env-file-if-exists=.env ./node_modules/.bin/tsx src/services/reconcile.ts",
    "ui:check": "node scripts/ui-check.mjs",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@supabase/supabase-js": "^2.119.2",
    "@turnkey/sdk-server": "^8.11.0",
    "@turnkey/solana": "^1.1.52",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.4",
    "tsx": "^4.21.0",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.29",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "stream-json": "^3.9.0"
  }
}
